# Environnement `cloud` : app sur Streamlit Community Cloud, backend sur Cloud Run.
#
# En ligne : coller ce contenu dans Settings → Secrets de l'app Streamlit.
# En local : copier ce fichier en .streamlit/secrets.toml (ignoré par git) pour
#            faire tourner l'app locale contre le backend GCP.
#
# BERLUE_API_URL est le seul réglage à fournir. Sa valeur est celle que donne
# `make cloudrun_url` dans le dépôt berlue ; elle dépend du projet GCP et de
# l'environnement déployé, et n'est donc pas versionnée ici.
#
# L'URL doit être publique : les requêtes partent du serveur Streamlit, où
# `localhost` désigne le conteneur de l'app et non la machine du visiteur.
BERLUE_API_URL = "https://<service>-<projet>.<region>.run.app"
