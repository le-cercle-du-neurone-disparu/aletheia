# Environnement `local` : l'app et le backend Berlue tournent sur la même
# machine (repo `berlue` : make run_api ou make docker_run_local).
#
# L'environnement `cloud` (Streamlit Community Cloud → Cloud Run) ne passe pas
# par ce fichier : son URL vit dans les secrets Streamlit, cf.
# .streamlit/secrets.toml.example.
BERLUE_API_URL=http://localhost:8000

# Backend Cloud Run, utilisé uniquement par `make run_app_gcp` pour tester
# l'environnement `cloud` depuis le poste local. L'app en ligne, elle, lit
# cette URL dans ses secrets Streamlit.
BERLUE_API_GCP_URL=https://<service>-<projet>.<region>.run.app
